{
  "command_name": "ek-nslookup",
  "help": "Make a DNS query",
  "extension_author": "Adaptix-Framework",
  "original_author": "Adaptix-Framework",
  "repo_url": "https://github.com/Adaptix-Framework/Extension-Kit",
  "version": "1.0.0",
  "entrypoint": "go",
  "files": [
    {
      "os": "windows",
      "arch": "amd64",
      "path": "nslookup.x64.o"
    }
  ],
  "arguments": [
    {
      "name": "domain",
      "desc": "Domain to query",
      "type": "z",
      "optional": false
    },
    {
      "name": "type",
      "desc": "Record type",
      "type": "z",
      "optional": true,
      "default": "A"
    },
    {
      "name": "server",
      "desc": "DNS server",
      "type": "z",
      "optional": true,
      "default": ""
    }
  ]
}