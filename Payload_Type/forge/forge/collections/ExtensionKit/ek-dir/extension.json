{
  "command_name": "ek-dir",
  "help": "Lists files in directory (wildcards, recursive)",
  "extension_author": "Adaptix-Framework",
  "original_author": "Adaptix-Framework",
  "repo_url": "https://github.com/Adaptix-Framework/Extension-Kit",
  "version": "1.0.0",
  "entrypoint": "go",
  "files": [
    {
      "os": "windows",
      "arch": "amd64",
      "path": "dir.x64.o"
    },
    {
      "os": "windows",
      "arch": "386",
      "path": "dir.x86.o"
    }
  ],
  "arguments": [
    {
      "name": "directory",
      "desc": "Directory to list",
      "type": "Z",
      "optional": true,
      "default": ".\\\\"
    },
    {
      "name": "recursive",
      "desc": "Recursive list (1=yes, 0=no)",
      "type": "i",
      "optional": true,
      "default": 0
    }
  ]
}