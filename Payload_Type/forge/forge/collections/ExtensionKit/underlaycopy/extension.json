{
  "command_name": "underlaycopy",
  "help": "Copy file using low-level NTFS access (MFT/Metadata)",
  "extension_author": "Adaptix-Framework",
  "original_author": "Adaptix-Framework",
  "repo_url": "https://github.com/Adaptix-Framework/Extension-Kit",
  "version": "1.0.0",
  "entrypoint": "go",
  "files": [
    {
      "os": "windows",
      "arch": "amd64",
      "path": "underlaycopy.x64.o"
    },
    {
      "os": "windows",
      "arch": "386",
      "path": "underlaycopy.x86.o"
    }
  ],
  "arguments": [
    {
      "name": "mode",
      "desc": "Copy mode: MFT or Metadata",
      "type": "z",
      "optional": false
    },
    {
      "name": "source",
      "desc": "Source file path",
      "type": "z",
      "optional": false
    },
    {
      "name": "destination",
      "desc": "Destination file path",
      "type": "z",
      "optional": true,
      "default": ""
    },
    {
      "name": "download",
      "desc": "Download instead (1=yes)",
      "type": "i",
      "optional": true,
      "default": 0
    }
  ]
}